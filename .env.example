# Postgres connection string (defaults to the docker-compose database when unset)
DATABASE_URL=postgres://elsa:elsa@localhost:5432/elsa?sslmode=disable

# Signs login tokens. Required, at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=

# Comma-separated allowed origins, supports * and ? wildcards
CORS_ALLOW_ORIGINS=http://localhost:*

# Only for e2e tests: enables POST /test/reset-db (DATABASE_URL must not point at "elsa")
# APP_ENV=test
# E2E_RESET_SECRET=
